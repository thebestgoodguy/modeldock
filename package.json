{
  "name": "modeldock",
  "private": true,
  "version": "1.0.0",
  "description": "A local Hugging Face model, dataset, and space downloader with queueing, logs, and Electron packaging.",
  "author": "Sadri ERCAN",
  "developerCreator": "Sadri ERCAN",
  "homepage": "https://github.com/thebestgoodguy/modeldock",
  "repository": {
    "type": "git",
    "url": "https://github.com/thebestgoodguy/modeldock.git"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "start:api": "node server.js",
    "electron": "npm run package:dir && .\\release\\win-unpacked\\ModelDock.exe",
    "electron:dev": "npm run package:dir && .\\release\\win-unpacked\\ModelDock.exe",
    "rebuild:native": "npm rebuild better-sqlite3",
    "package:dir": "npm run build && electron-builder --dir && npm run rebuild:native",
    "package:win": "npm run build && electron-builder --win && npm run rebuild:native",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('release',{recursive:true,force:true});\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.6",
    "dompurify": "^3.4.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "marked": "^18.0.3",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^35.7.5",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "build": {
    "appId": "com.sadriercan.modeldock",
    "productName": "ModelDock",
    "copyright": "Copyright © 2026 Sadri ERCAN",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server.js",
      "downloader.py",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "downloader.py",
        "to": "downloader.py"
      },
      {
        "from": ".env.example",
        "to": ".env.example"
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false,
      "artifactName": "ModelDock-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
